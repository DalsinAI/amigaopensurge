diff --git a/src/physfs_platform_posix.c b/src/physfs_platform_posix.c
index e2f72e5..cb739c4 100644
--- a/src/physfs_platform_posix.c
+++ b/src/physfs_platform_posix.c
@@ -59,25 +59,35 @@ static char *getUserDirByUID(void)
 static char *getUserDirByUID(void)
 {
+#if defined(__amigaos3__)
+    static const char path[] = "PROGDIR:";
+    char *retval = (char *) allocator.Malloc(sizeof (path));
+
+    if (retval != NULL)
+        memcpy(retval, path, sizeof (path));
+
+    return retval;
+#else
     uid_t uid = getuid();
     struct passwd *pw;
     char *retval = NULL;
 
     pw = getpwuid(uid);
     if ((pw != NULL) && (pw->pw_dir != NULL) && (*pw->pw_dir != '\0'))
     {
         const size_t dlen = strlen(pw->pw_dir);
         const size_t add_dirsep = (pw->pw_dir[dlen-1] != '/') ? 1 : 0;
         retval = (char *) allocator.Malloc(dlen + 1 + add_dirsep);
         if (retval != NULL)
         {
             strcpy(retval, pw->pw_dir);
             if (add_dirsep)
             {
                 retval[dlen] = '/';
                 retval[dlen+1] = '\0';
             } /* if */
         } /* if */
     } /* if */
     
     return retval;
+#endif
 } /* getUserDirByUID */
 
 

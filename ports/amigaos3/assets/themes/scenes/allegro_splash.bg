// AmigaOS 3 / OpenGPU override.
// The upstream 1704x2640 animation atlas stalls the current SDL2.module path,
// so use its final Allegro logo frame as a compact true-colour image.

background
{
    initial_position    0 0
    scroll_speed        0 0
    behavior            DEFAULT
    repeat_x            FALSE
    repeat_y            FALSE

    sprite
    {
        source_file     "images/scenes/allegro_splash.png"
        source_rect     0 0 426 240
        frame_size      426 240
        hot_spot        0 0

        animation 0
        {
            repeat      FALSE
            fps         1
            data        0
        }
    }
}
